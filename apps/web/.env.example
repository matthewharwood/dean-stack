VITE_GAME_TITLE=dean-stack
# VITE_API_BASE=

# URL to the printable Halid Worksheets companion app. Defaults to /worksheets/
# (co-deployment under one domain). In dev, override to the worksheets app's
# preview URL (default: http://localhost:3010/).
# VITE_WORKSHEETS_URL=http://localhost:3010/

# Public canonical URL of the deployed site. Must end with "/".
# Local dev: http://localhost:3000/
# GH Pages project: https://<user>.github.io/<repo>/
# Custom domain:    https://example.com/
VITE_SITE_URL=http://localhost:3000/

# 40–300 chars. Goes into <meta name="description">, og:description, twitter:description.
VITE_SITE_DESCRIPTION=Rapid-prototyping platform for browser games — built live on an iPad over LAN, deployed static to GitHub Pages.

# Optional. Defaults to /og-card.svg (shipped). Override with an absolute URL or a /public/ path.
# VITE_OG_IMAGE=/og-card.svg

# Optional author attribution — shows in JSON-LD Person + meta[name="author"] + article:author.
# VITE_AUTHOR_NAME=Matt Harwood
# VITE_AUTHOR_URL=https://github.com/matthhar12
# VITE_TWITTER_HANDLE=@matthhar
